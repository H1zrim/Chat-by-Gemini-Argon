# ============================================================================
# RT-Ku Community & Chat Platform — Environment Configuration Template
# Salin file ini menjadi `.env` untuk penggunaan lokal (file `.env` di-ignore oleh Git)
# ============================================================================

PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Secret untuk penandatanganan token sesi (Ganti dengan string acak di produksi)
SESSION_SECRET=ganti_dengan_kunci_rahasia_acak_minimal_32_karakter

# Opsional: Integrasi AI Asisten Warga (JANGAN pernah commit API Key asli ke Git!)
AI_PROVIDER=gemini
GEMINI_API_KEY=
